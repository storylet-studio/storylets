#!/bin/sh
# Refuse a push that moves a published package's source with no changeset covering it.
#
# The gap this closes: this repo works directly on main, and a changeset-check on a pull
# request cannot see a push that never becomes one. Patterplay shipped two packages'
# features straight to main and its release ran green having published nothing, leaving
# the registry serving one build under a version number the repo had given to another.
#
# Pre-push rather than pre-commit on purpose: a changeset describes a RELEASE, and
# mid-work commits have no business being asked for one. The push is the moment the work
# becomes everyone's.
#
# Reads git's own stdin (`<local ref> <local sha> <remote ref> <remote sha>`) so the
# comparison is against what the REMOTE actually has, not a possibly stale origin/main.
#
# Wired via `core.hooksPath = scripts/git-hooks` (set by the root `prepare` script).
# `git push --no-verify` skips it; ci.yml runs the same guard as the backstop.
#
# LOCAL ONLY. `npm ci` runs `prepare`, so CI wires these hooks too, and this one would
# then fire on the Changesets bot's own push: the "Version Packages" commit CONSUMES the
# changesets while the source changes they covered are still in the range, so the guard
# would see a moved package with nothing justifying it and refuse. The bot is doing
# exactly the right thing, and a developer-convenience hook has no business gating an
# automated release.
set -e

if [ -n "$CI" ]; then
  exit 0
fi

z40=0000000000000000000000000000000000000000

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue                   # a branch deletion pushes nothing
  if [ "$remote_sha" = "$z40" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")  # a brand-new branch
    [ -z "$base" ] && continue
  else
    base="$remote_sha"
  fi
  node scripts/release-guard.mjs "$base" "$local_sha" || {
    echo "pre-push: aborted. Add a changeset, or push with --no-verify if you are certain." >&2
    exit 1
  }
done
