{
  schema: "storylets/deck@0",
  deck: {
    condition: "@act > \"act-1\"",
    gameId: "miras-secret",
    id: "k_mira",
    properties: [
      {
        default: [],
        name: "progress",
        type: "flags",
        values: [
          "distracted_seen",
        ],
      },
    ],
    purpose: "The innkeeper is hiding something older than the village.",
    title: "Mira's Secret",
  },
  cards: [
    {
      condition: "@act >= \"act-1\" and check_flags(@rel_innkeeper, +met) and not check_flags(@deck.progress, +distracted_seen)",
      fields: {
        music: "inn",
      },
      gameId: "mira-seems-distracted",
      id: "c_mira_distracted",
      outcomes: [
        {
          changes: {
            "@deck.progress": "set_flags(@deck.progress, +distracted_seen)",
          },
          gameId: "hold-her-gaze",
          id: "c_md_o",
          title: "Hold her gaze a moment",
        },
      ],
      priority: 3,
      purpose: "Mira keeps glancing at the sealed door behind the bar. She catches you noticing and looks away.",
      redraw: "never",
      tags: {
        place: [
          "h_inn",
        ],
      },
      title: "Mira Seems Distracted",
    },
    {
      condition: "check_flags(@deck.progress, +distracted_seen) and check_flags(@rel_innkeeper, +warm)",
      fields: {
        music: "unease",
      },
      gameId: "the-sealed-letter",
      id: "c_mira_letter",
      outcomes: [
        {
          changes: {
            "@story.rel_innkeeper": "set_flags(@rel_innkeeper, +reported)",
          },
          gameId: "read-it",
          id: "c_ml_read",
          title: "Read it while you can",
        },
        {
          changes: {
            "@story.rel_innkeeper": "set_flags(@rel_innkeeper, +trusts)",
            "@story.reputation": "@reputation + 1",
          },
          gameId: "return-it-unread",
          id: "c_ml_return",
          title: "Return it unread",
        },
      ],
      priority: 4,
      purpose: "A letter slips from Mira's ledger, sealed with a symbol you have seen carved on the old well.",
      redraw: "never",
      tags: {
        place: [
          "h_inn",
        ],
      },
      title: "The Sealed Letter",
    },
  ],
}
