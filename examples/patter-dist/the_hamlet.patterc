  "schema": "patter/bundle@0",
  "scopeRegistry": {
    "scopes": [
      {
        "declarations": [
          {
            "default": "day",
            "name": "time_of_day",
            "purpose": "The host owns time. Declared here so scenes may READ it; read-only so no scene can move it. Must agree with the storylet project, which declares the same property: the demo build checks that.",
            "type": "enum",
            "values": [
              "day",
              "night"
            ],
            "writable": false
          },
          {
            "default": false,
            "name": "knows_road",
            "purpose": "Set by dialogue (asking Mira about the road north) and read by a storylet card: the one value in this demo that flows FROM Patter TO the Storylet Engine, through the shared @world.",
            "type": "boolean",
            "writable": true
          }
        ],
        "token": "world"
      }
    ],
    "version": 1
  },
  "strings": {
    "en": {
      "L_0fo3qd00": "Tell me about the village's history?",
      "L_2f959091": "Walk away; it isn't your fight",
      "L_2fc9040b": "Stay polite but keep your distance",
      "L_339162b1": "Touch the glowing bark",
      "L_35ae96fb": "Ask warmly about the village's history",
      "L_3cd263e4": "Return it unread",
      "L_4293104b": "Read it while you can",
      "L_46a74010": "Leave him be",
      "L_55b237b4": "Talk straight: ask if he's hiring",
      "L_5cd828ac": "Stand with Gareth against them",
      "L_5ede4b2d": "Step back and observe carefully",
      "L_60d0e4ea": "Pledge your help to the village",
      "L_77ea940b": "Ask him what's wrong",
      "L_79adade3": "Ask only about the road north",
      "L_7b4a6gin": "The square is alive with haggling and gossip.",
      "L_7d4a7ebc": "Admire the work openly",
      "L_91ogw8pc": "I can take a hint.",
      "L_a24x6snq": "Hello - I'm Mira. Welcome to our village. Can I help you, stranger?",
      "L_ac695055": "Pay the debt yourself",
      "L_brs8i80t": "Thanks, I'm glad you like it. I'm Gareth, by the way.",
      "L_fvqkrpvr": "Hello! I hear you're looking for things to do in the village. Could you help us?",
      "L_j8kzoojp": "Wow! That's amazing!",
      "L_knp4fifu": "Are you hiring?",
      "L_puz4l9h5": "A child runs off with an apple and a trader shakes his fist.",
      "L_r41z2eh1": "Mira tells you how to find the road north.",
      "L_rw9nw1pw": "I'll help you!",
      "L_sbhl9llk": "It's good to meet you.",
      "L_tqr5bzh5": "There is laughter from the square.",
      "L_u61bszwi": "Tell me about the road north.",
      "L_uovzn5vn": "Wonderful!",
      "L_xscc5c4p": "Mira explains about the village's history.",
      "L_z5ox6on8": "Not right now I'm afraid. By the way, I'm Gareth. Nice to meet a straight-talker.",
      "L_zgv6v66a": "The inn is busy with customers, sunlight streaming through the windows.",
      "T_07a7313f": "The blacksmith barely looks up from the anvil. He's focused on a wrought-iron candlestick of rosebuds and leaves.",
      "T_1d6e17eb": "STUB: Mira Seems Distracted. Replace with the scene.",
      "T_2083f3db": "A the trader is loudly overselling turnips. ",
      "T_32e27eb0": "STUB: The Sealed Letter. Replace with the scene.",
      "T_374799a6": "STUB: The Moneylender's Men. Replace with the scene.",
      "T_434207f4": "STUB: The Forest Turns Wary. Replace with the scene.",
      "T_5ddd00b7": "STUB: The Glowing Tree at Night. Replace with the scene.",
      "T_665628bb": "STUB: Gareth Looks Troubled. Replace with the scene.",
      "T_711f18c2": "You can see the track Mira described, that leads north through the forest.",
      "T_77a352f0": "Rumour reaches you that Bryna, the village elder, would like to visit you. So you head to her house to talk to her.",
      "T_8a7f142c": "The forest breathes around you. The trail markers are older than the village.",
      "T_985d8f12": "You step into the inn.",
      "T_ac3557d9": "The road ends at a weathered gate; smoke rises from the Inn beyond. Welcome to the village of Ham.",
      "T_acf6f963": "STUB: Gareth's Gratitude. Replace with the scene.",
      "T_b7c23642": "Lamps gutter; the well stands black and still. Something feels watchful after dark.",
      "T_f2fd9755": "STUB: The Tree Blooms. Replace with the scene.",
      "T_f8c5f777": "A hammer keeps time across the village from the forge, steady as a heartbeat.",
      "T_inn_night": "The common room is quiet this late."
    }
  },
  "voiced": true
}
