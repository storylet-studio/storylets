{
  schema: "storylets/deck@0",
  deck: {
    gameId: "street-trouble",
    id: "k_street",
    properties: [],
    purpose: "The ambient tier: what the city throws at anyone. Every card ends with Moved on - the game's release valve when the player disengages.",
    title: "Street Trouble",
  },
  cards: [
    {
      condition: "@heat >= \"watched\" && @hand.patrolled",
      gameId: "checkpoint-shakedown",
      id: "c_checkpoint",
      order: 2,
      outcomes: [
        {
          changes: {},
          gameId: "moved-on",
          id: "c_checkpoint_moved_on",
          order: 3,
          title: "Moved on",
        },
        {
          changes: {
            "@story.heat": "advance(@heat)",
          },
          condition: "@world.armed",
          gameId: "push-past",
          id: "c_checkpoint_push_past",
          order: 2,
          title: "Push past",
        },
        {
          changes: {},
          gameId: "talk-through-it",
          id: "c_checkpoint_talk_through_it",
          order: 0,
          title: "Talk through it",
        },
        {
          changes: {},
          gameId: "turn-out-your-pockets",
          id: "c_checkpoint_turn_out_your_pockets",
          order: 1,
          title: "Turn out your pockets",
        },
      ],
      priority: 2,
      purpose: "Port Authority barriers and bored officers with a quota. They only bother with people the city has noticed.",
      redraw: 3,
      title: "Checkpoint Shakedown",
    },
    {
      condition: "@heat == \"unnoticed\"",
      copies: 2,
      gameId: "corner-hustle",
      id: "c_corner_hustle",
      order: 0,
      outcomes: [
        {
          changes: {},
          gameId: "moved-on",
          id: "c_corner_hustle_moved_on",
          order: 1,
          title: "Moved on",
        },
        {
          changes: {},
          gameId: "wave-them-off",
          id: "c_corner_hustle_wave_them_off",
          order: 0,
          title: "Wave them off",
        },
      ],
      priority: 0,
      purpose: "Three-card monte and a spotter. Harmless, as long as nobody important is watching you win.",
      redraw: 3,
      title: "Corner Hustle",
    },
    {
      condition: "@heat >= \"hunted\" && @world.time_of_day == \"night\"",
      gameId: "drone-sweep",
      id: "c_drone_sweep",
      order: 3,
      outcomes: [
        {
          changes: {},
          gameId: "hide-until-it-passes",
          id: "c_drone_sweep_hide_until_it_passes",
          order: 0,
          title: "Hide until it passes",
        },
        {
          changes: {},
          gameId: "moved-on",
          id: "c_drone_sweep_moved_on",
          order: 2,
          title: "Moved on",
        },
        {
          changes: {},
          condition: "@world.armed",
          gameId: "shoot-it-down",
          id: "c_drone_sweep_shoot_it_down",
          order: 1,
          title: "Shoot it down",
        },
      ],
      priority: 3,
      purpose: "A searchlight with a serial number, walking its grid. It knows your face now.",
      redraw: 2,
      title: "Drone Sweep",
    },
    {
      gameId: "pickpocket",
      id: "c_pickpocket",
      order: 1,
      outcomes: [
        {
          changes: {},
          gameId: "caught-their-wrist",
          id: "c_pickpocket_caught_their_wrist",
          order: 0,
          title: "Caught their wrist",
        },
        {
          changes: {},
          gameId: "moved-on",
          id: "c_pickpocket_moved_on",
          order: 2,
          title: "Moved on",
        },
        {
          changes: {},
          gameId: "they-got-away",
          id: "c_pickpocket_they_got_away",
          order: 1,
          title: "They got away with it",
        },
      ],
      priority: 1,
      purpose: "A bump in the crowd, a light hand. The game decides what was in that pocket.",
      redraw: 4,
      title: "Pickpocket",
    },
  ],
