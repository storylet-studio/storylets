{
  schema: "storylets/deck@0",
  deck: {
    gameId: "files",
    id: "k_files",
    properties: [],
    purpose: "What the player's terminal knows. Each entry's condition is its unlock; the body field is the article the UI renders.",
    title: "Files",
  },
  cards: [
    {
      condition: "check_flags(@events, +blackout_done)",
      fields: {
        body: "For six hours the Old Grid ran on candles and car batteries. The Collective calls it a proof of concept. Port Authority calls it terrorism.",
      },
      gameId: "the-blackout",
      id: "c_cx_blackout",
      order: 4,
      outcomes: [],
      priority: 4,
      purpose: "Unlocked by the night the Old Grid went dark.",
      redraw: "never",
      title: "The Blackout",
    },
    {
      condition: "check_flags(@rel_collective, +met)",
      fields: {
        body: "Nobody joins the Collective; you just notice you've been helping them for a while. They want the city's grid back in the city's hands.",
      },
      gameId: "the-grid-collective",
      id: "c_cx_collective",
      order: 2,
      outcomes: [],
      priority: 8,
      purpose: "Unlocked the first time the Collective shows itself.",
      redraw: "never",
      title: "The Grid Collective",
    },
    {
      condition: "@heat >= \"watched\"",
      fields: {
        body: "Port Authority doesn't chase everyone. It watches, it ranks, and past a certain point it hunts. Keep your head down and the ladder forgets - slowly.",
      },
      gameId: "heat",
      id: "c_cx_heat",
      order: 3,
      outcomes: [],
      priority: 6,
      purpose: "Unlocked when the city first takes notice - the system teaching itself to the player.",
      redraw: "never",
      title: "Heat",
    },
    {
      fields: {
        body: "A freeport built on stilts and waivers. Three districts, one harbour, no questions at the waterline.",
      },
      gameId: "port-meridian",
      id: "c_cx_meridian",
      order: 0,
      outcomes: [],
      priority: 10,
      purpose: "The seed entry: every codex starts somewhere.",
      redraw: "never",
      title: "Port Meridian",
    },
    {
      condition: "check_flags(@rel_syndicate, +met)",
      fields: {
        body: "Freight, favours and finality. The Syndicate moves what the port pretends not to see, and it pays couriers who don't ask.",
      },
      gameId: "the-ashfall-syndicate",
      id: "c_cx_syndicate",
      order: 1,
      outcomes: [],
      priority: 8,
      purpose: "Unlocked the first time the Syndicate learns your name.",
      redraw: "never",
      title: "The Ashfall Syndicate",
    },
  ],
}
