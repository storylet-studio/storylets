  "strings": {
    "L_46a74010": "Leave him be",
    "L_77ea940b": "Ask him what's wrong",
    "L_duorb56a": "You leave the blacksmith be.",
    "L_mugh0agc": "What's wrong?",
    "L_ry8ctl75": "I've got money troubles. I'm worried Aldric might come to collect, and I can't pay.",
    "T_665628bb": "The hammer has gone quiet. Gareth is staring at a letter he keeps folding and unfolding.",
  },
}
