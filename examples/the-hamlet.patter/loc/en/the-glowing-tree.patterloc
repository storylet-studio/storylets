  "schema": "patter/strings@0",
  "strings": {
    "L_339162b1": "Touch the glowing bark",
    "L_5ede4b2d": "Step back and observe carefully",
    "L_fi6ap28z": "It's beautiful.",
    "L_z8x2nipw": "You feel a tingling sensation, and your fingers leave bright marks on the bark.",
    "T_5ddd00b7": "Deep in the forest the Mystic Tree burns with a soft light, as if it has been waiting to be addressed.",
  },
}
