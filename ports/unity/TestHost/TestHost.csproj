<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain dotnet console that replays the conformance corpus through the C#
       Storylet Engine runtime, so the port's parity is verifiable OUTSIDE Unity
       (CI, local). It compiles the same Runtime/**/*.cs the Unity asmdefs ship
       (pure layer + Newtonsoft Json layer), pinned to LangVersion 9 to stay
       Unity-2021.3-safe. Never ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>StoryletEngine.TestHost</AssemblyName>
    <RootNamespace>StoryletStudio.StoryletEngine.TestHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LiveLinkFixture.cs" />
    <!-- One registry per game: packages/runtime/test/one-registry.test.ts, ported. -->
    <Compile Include="OneRegistry.cs" />
    <!-- The registry corpus runner, vendored from expr/ports/unity/testing. -->
    <Compile Include="RegistryCorpus.cs" />
    <Compile Include="../StoryletEngine/Runtime/**/*.cs" />
    <!-- The UnityEngine-touching runtime layer (bundle asset, debug registry)
         cannot compile outside Unity; everything else under Runtime/ stays
         engine-free and corpus-verified here. -->
    <Compile Remove="../StoryletEngine/Runtime/Unity/**/*.cs" />
    <!-- The skew assembly is one #error line that Unity compiles only when an old
         Patterplay is installed beside this package; it is never part of a build
         that compiles the kernel, and this host compiles the kernel (Runtime/Expr)
         exactly once. -->
    <Compile Remove="../StoryletEngine/Runtime/ExprSkew/**/*.cs" />
  </ItemGroup>

  <!-- The Unity loader layer uses Newtonsoft (com.unity.nuget.newtonsoft-json in
       Unity); referencing the same namespace here verifies that loader too. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
