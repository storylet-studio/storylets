{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@storylet-studio/model": ["packages/model/src/index.ts"],
      "@storylet-studio/dialect": ["packages/dialect/src/index.ts"],
      "@storylet-studio/compiler": ["packages/compiler/src/index.ts"],
      "@storylet-studio/runtime": ["packages/runtime/src/index.ts"],
      "@storylet-studio/play-helpers": ["packages/play-helpers/src/index.ts"],
      "@storylet-studio/ops": ["packages/ops/src/index.ts"],
      "@storylet-studio/conformance": ["packages/conformance/src/index.ts"],
      "@wildwinter/expr": ["../expr/packages/expr/src/index.ts"],
      "@wildwinter/expr-specificity": ["../expr/packages/expr-specificity/src/index.ts"],
      "@wildwinter/scoperegistry": ["../expr/packages/scoperegistry/src/index.ts"]
    }
  },
  // THE PACKAGE, not a list of the directories a package happens to use. This was
  // `packages/*/src` + `packages/*/test`, which left `play-helpers/demo` and
  // `cli/tsup.config.ts` outside the program entirely - unchecked unless
  // something inside it imported them, which nothing does. Same trap as the
  // studio's per-window list, one level up (patterkit to-storylets, 2026-08-17).
  //
  // `packages`, bare: `include` takes a DIRECTORY and means everything under it,
  // where `packages/*` is a glob over names one level down and matches no files.
  //
  // What is excluded is generated output and the app. `dist` is build product and
  // never wants checking as a root; `packages/studio` has its own two programs,
  // split by RUNTIME - a DOM file checked again here, with no DOM lib, would fail
  // for a reason that is about this config rather than about the code.
  "include": ["packages"],
  "exclude": ["node_modules", "packages/*/dist", "packages/studio"]
}
