---
const engines = [
  { icon: "plugin-javascript.svg", name: "JavaScript" },
  { icon: "plugin-unity.svg", name: "Unity" },
  { icon: "plugin-unreal.svg", name: "Unreal" },
  { icon: "plugin-godot.svg", name: "Godot" },
];
// The Storylet Studio home. A STANDALONE page (its own header and footer, light-only),
// deliberately outside the Starlight docs chrome. Brand tokens come from
// src/styles/storylets.css; the landing's own classes live in src/styles/landing.css.
//
// Shape, top to bottom: header, a two-column opening (one sentence, one paragraph, one button,
// the split-deck picture), the list of situations, the Board screenshot, the three tools as
// paragraphs, the downloads as a list, the footer. The Patter site is a script; this page is a
// hand of cards. They share a footer and nothing else in structure.
import "../styles/storylets.css";
import "../styles/landing.css";
import Newsletter from "../components/Newsletter.astro";
import Downloads from "../components/Downloads.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"); // normalise to a trailing slash
const repo = "https://github.com/storylet-studio/storylets";
const title = "Storylet Studio";
const description =
  "An open toolkit for storylets. Your designers write small pieces of story as cards, each with a rule for when it fits, and your game deals the ones that fit the moment, on Unity, Unreal, Godot, or the web.";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://storylet.studio/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://storylet.studio/social-card.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://storylet.studio/social-card.png" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>{"body{margin:0}"}</style>
  </head>
  <body>
    <div class="sy-landing">
      <!-- HEADER -->
      <header class="sy-head">
        <div class="sy-wrap sy-head-inner">
          <a class="sy-brand" href={base} aria-label="Storylet Studio home">
            <svg viewBox="0 0 100 100" width="28" height="28" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <g fill="none">
                <path d="M88 12 C5 12 5 50 50 50 C95 50 95 88 12 88" stroke="#36284a" stroke-width="12" stroke-linecap="round"></path>
                <circle cx="88" cy="12" r="9.5" fill="#c8902f"></circle>
                <circle cx="12" cy="88" r="9.5" fill="#c8902f"></circle>
                <circle cx="50" cy="50" r="9.5" fill="#c8902f"></circle>
              </g>
            </svg>
            <span class="sy-wordmark">Storylet Studio</span>
          </a>
          <nav class="sy-navlinks" aria-label="Site">
            <a class="sy-navlink" href="#tools">The tools</a>
            <a class="sy-navlink" href={`${base}why/`}>Why Storylet Studio</a>
            <a class="sy-navlink" href="#download">Download</a>
            <a class="sy-navlink" href={repo}>GitHub</a>
            <a class="sy-btn sy-btn-outline" href={`${base}getting-started/`}>Get started</a>
          </nav>
        </div>
      </header>

      <!-- OPENING -->
      <section class="sy-open">
        <div class="sy-wrap sy-open-grid">
          <div class="sy-open-copy">
            <h1 class="sy-h1">Decide what happens next by dealing a hand of story cards.</h1>
            <p class="sy-lead">A storylet is a small piece of story with a rule for when it fits. Your designers write
              them as cards in Storyletter, you drop one file into Unity, Unreal, Godot, or the web, and whenever your
              game needs to pick something, it asks the engine for a hand and gets the cards that fit the moment.</p>
            <div class="sy-actions">
              <a class="sy-btn sy-btn-primary" href={`${base}getting-started/`}>Get started</a>
              <a class="sy-link" href="#download">Download Storyletter</a>
            </div>
            <p class="sy-note">It's free and MIT-licensed, and there's no server to run.</p>
          </div>

          {/* One deck, cut on the diagonal: the same six cards as a grid and as a flow. The
              split is the argument the picture makes, so it's one picture rather than two.
              Card faces top-left, the arrows the tool worked out bottom-right. */}
          <figure class="sy-deck">
            <svg class="sy-both" viewBox="0 0 520 372" role="img" aria-labelledby="sy-both-t">
              <title id="sy-both-t">One deck shown two ways at once, divided on the diagonal. The
                upper half is its cards as a grid, each with the rule for when it comes up. The lower
                half is the same cards as a flow, with arrows the tool worked out from those rules:
                one card opens up another, and shuts a third off.</title>
              <defs>
                <clipPath id="sy-cut-cards"><path d="M0 0 H520 V0 L0 372 Z"></path></clipPath>
                <clipPath id="sy-cut-flow"><path d="M520 0 V372 H0 Z"></path></clipPath>
                <marker id="sy-a-on" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0 0 L8 4 L0 8 z" fill="var(--sy-plum-tint)"></path>
                </marker>
                <marker id="sy-a-off" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0 0 L8 4 L0 8 z" fill="var(--sy-amber)"></path>
                </marker>
              </defs>

              <g clip-path="url(#sy-cut-cards)">
                <g class="sy-gc"><rect x="20" y="16" width="128" height="70" rx="10"></rect>
                  <text class="sy-gc-t" x="32" y="38">The Blacksmith&apos;s</text>
                  <text class="sy-gc-t" x="32" y="54">Trouble</text>
                  <text class="sy-gc-r" x="32" y="72">when: met Gareth</text></g>
                <g class="sy-gc"><rect x="156" y="16" width="128" height="70" rx="10"></rect>
                  <text class="sy-gc-t" x="168" y="38">Gareth Asks</text>
                  <text class="sy-gc-t" x="168" y="54">for Help</text>
                  <text class="sy-gc-r" x="168" y="72">when: he owes you</text></g>
                <g class="sy-gc"><rect x="292" y="16" width="128" height="70" rx="10"></rect>
                  <text class="sy-gc-t" x="304" y="38">The Ring of</text>
                  <text class="sy-gc-t" x="304" y="54">the Anvil</text>
                  <text class="sy-gc-r" x="304" y="72">when: always</text></g>
                <g class="sy-gc"><rect x="20" y="100" width="128" height="70" rx="10"></rect>
                  <text class="sy-gc-t" x="32" y="122">A Rumour at</text>
                  <text class="sy-gc-t" x="32" y="138">the Inn</text>
                  <text class="sy-gc-r" x="32" y="156">when: debt called</text></g>
                <g class="sy-gc"><rect x="156" y="100" width="128" height="70" rx="10"></rect>
                  <text class="sy-gc-t" x="168" y="122">The Forge</text>
                  <text class="sy-gc-t" x="168" y="138">Falls Quiet</text>
                  <text class="sy-gc-r" x="168" y="156">when: debt called</text></g>
                <g class="sy-gc"><rect x="20" y="184" width="128" height="70" rx="10"></rect>
                  <text class="sy-gc-t" x="32" y="206">Mira Pours</text>
                  <text class="sy-gc-t" x="32" y="222">a Second</text>
                  <text class="sy-gc-r" x="32" y="240">when: evening</text></g>
              </g>

              <g clip-path="url(#sy-cut-flow)">
                {/* Its own ground, so the cards it covers read as tucked underneath rather
                    than as rectangles that failed to draw. */}
                <path class="sy-flow-ground" d="M520 0 V372 H0 Z"></path>
                <g class="sy-fe sy-fe-on">
                  <path d="M310 282 C342 282 340 206 370 206" marker-end="url(#sy-a-on)"></path>
                  <text x="340" y="196">opens up</text>
                </g>
                <g class="sy-fe sy-fe-off">
                  <path d="M310 300 C342 300 340 294 370 294" marker-end="url(#sy-a-off)"></path>
                  <text x="341" y="322">shuts off</text>
                </g>
                <g class="sy-fn sy-fn-sel"><rect x="150" y="268" width="160" height="56" rx="11"></rect>
                  <text class="sy-fn-t" x="166" y="292">The Blacksmith&apos;s</text>
                  <text class="sy-fn-t" x="166" y="310">Trouble</text></g>
                <g class="sy-fn"><rect x="370" y="180" width="140" height="52" rx="11"></rect>
                  <text class="sy-fn-t" x="384" y="204">Gareth Asks</text>
                  <text class="sy-fn-t" x="384" y="222">for Help</text></g>
                <g class="sy-fn"><rect x="370" y="268" width="140" height="52" rx="11"></rect>
                  <text class="sy-fn-t" x="384" y="292">The Forge</text>
                  <text class="sy-fn-t" x="384" y="310">Falls Quiet</text></g>
              </g>
              <path class="sy-seam" d="M520 0 L0 372"></path>
            </svg>
            <figcaption class="sy-deck-caption">One deck, cut on the diagonal. Above the cut are the cards as you
              write them, each with its rule. Below it is the flow the tool worked out from those rules, without
              you drawing a line.</figcaption>
          </figure>
        </div>
      </section>

      <!-- WHERE YOU'D USE IT -->
      <section class="sy-uses">
        <div class="sy-wrap">
          <h2 class="sy-h2">Where you'd use it</h2>
          <p class="sy-uses-lead">Anywhere your game has to pick from a pool of possibilities, that's a box of cards.
            There's more on what it's for on the <a href={`${base}why/`}>Why Storylet Studio</a> page.</p>
          <ul class="sy-uses-list">
            <li>Pick which scene of your story plays next.</li>
            <li>Choose the topics an NPC has to talk about.</li>
            <li>Spawn the encounter that fits this spot on the map.</li>
            <li>Decide which items turn up to be picked up.</li>
            <li>Offer the player a quest or a job.</li>
            <li>Work out who's in town today.</li>
            <li>Pick the bark line that fits right now (though <a href="https://patterkit.dev">Patter</a> is the better tool for barks).</li>
            <li>Choose the lore that appears in the player's codex.</li>
            <li>Give an actor at an immersive event the topic to raise with a visitor.</li>
            <li>Send a visitor on to the next room of an interactive event.</li>
          </ul>
        </div>
      </section>

      <!-- THE BOARD -->
      <section class="sy-board">
        <div class="sy-wrap sy-board-grid">
          <div class="sy-board-copy">
            <h2 class="sy-h2">Watch a hand get dealt</h2>
            <p>Press Play in Storyletter and the Board deals turn by turn, laying each place's hand out under its
              name so you can see what the engine picked and what it left in the box. The journal down the side
              records what it looked at and why it passed a card over, so "why didn't that happen?" has an answer
              you can read.</p>
          </div>
          <img class="sy-board-shot" src={`${base}doc-images/Board.png`} width="2940" height="1682" alt="The Board in Storyletter: three hands, The Forge, The Inn, and The Mystic Tree, each holding the cards just dealt to it, with the journal of the session down the right" />
        </div>
      </section>

      <!-- THE TOOLS -->
      <section id="tools" class="sy-tools">
        <div class="sy-wrap sy-tools-inner">
          <div class="sy-tool">
            <h2 class="sy-h2">Storyletter</h2>
            <p>The editor, for the people designing the content. You design a card, give it a rule for when it comes up,
              and press Play to see what the real engine deals. The node view draws how your cards connect from the
              rules you wrote, and you never wire anything up. <a href={`${base}storyletter/overview/`}>Read about Storyletter.</a></p>
          </div>
          <div class="sy-tool">
            <h2 class="sy-h2">Storylet Engine</h2>
            <p>The runtime, for the people shipping the game. What Storyletter dealt at the desk is what your build deals, because the editor runs the same engine your game does. There’s one for your engine, and it loads the one bundle Storyletter publishes. <a href={`${base}play/overview/`}>Read about the runtimes.</a></p>
            <ul class="sy-engines">
              {engines.map((e) => (
                <li><img src={`${base}${e.icon}`} alt="" width="30" height="30" /><span>{e.name}</span></li>
              ))}
            </ul>
          </div>
          <div class="sy-tool">
            <h2 class="sy-h2">The CLI</h2>
            <p>The command line, for the project lead and CI. <code>storyletengine</code> creates, validates, compiles,
              merges, and measures coverage from a terminal. It runs the same code as the editor, so you can gate a
              build on it and fail the build on a card nothing can reach. <a href={`${base}cli/`}>Read about the CLI.</a></p>
          </div>
        </div>
      </section>

      <!-- DOWNLOADS -->
      <section id="download" class="sy-downloads">
        <div class="sy-wrap sy-downloads-inner">
          <h2 class="sy-h2">Download Storyletter</h2>
          {/* One line: Astro collapses a newline before an inline element to nothing. */}
          <p>The latest release, read live from GitHub. The runtimes, the CLI, and two playable examples are on the <a href={`${base}download/`}>download page</a>.</p>
          <Downloads kind="storyletter" />
        </div>
      </section>

      <!-- FOOTER -->
      <footer class="sy-foot">
        <div class="sy-wrap sy-foot-signup"><Newsletter variant="landing" /></div>
        <div class="sy-wrap sy-foot-inner">
          <div class="sy-foot-brand">
            <svg viewBox="0 0 100 100" width="22" height="22" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <g fill="none">
                <path d="M88 12 C5 12 5 50 50 50 C95 50 95 88 12 88" stroke="#9a89b5" stroke-width="12" stroke-linecap="round"></path>
                <circle cx="88" cy="12" r="9.5" fill="#e0b463"></circle>
                <circle cx="12" cy="88" r="9.5" fill="#e0b463"></circle>
                <circle cx="50" cy="50" r="9.5" fill="#e0b463"></circle>
              </g>
            </svg>
            <span>Storylet Studio</span>
          </div>
          <nav class="sy-foot-links" aria-label="Footer">
            <a href={`${base}why/`}>Why Storylet Studio</a>
            <a href={`${base}storyletter/overview/`}>Storyletter</a>
            <a href={`${base}play/overview/`}>Runtimes</a>
            <a href={`${base}download/`}>Download</a>
            <a href={repo}>GitHub</a>
          </nav>
          {/* One line, no internal newlines: Astro collapses a newline between text and an
              adjacent inline element to nothing, which ran "made by" into the author link. */}
          <p class="sy-foot-credit">Storylet Studio is <a href={`${base}licensing/`}>MIT-licensed</a> open source, made by <a href="https://ian.wildwinter.net" rel="author">Ian Thomas</a>.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
