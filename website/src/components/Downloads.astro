---
// Curated download sections, read live from the public, CORS-enabled GitHub Releases
// API in the BROWSER, so they stay current without rebuilding the static site.
//
// Each instance renders ONE section (`kind`) as a plain list, one row per file, with a
// bordered button on the row: "storyletter" (per-platform installers, from bare `v*` tags),
// "plugins" (the four runtime zips, from `play-<engine>-v*` tags), "cli" (the standalone
// binaries, from `cli-v*`), "village" (the playable example, from `village-v*`) or "hamlet"
// (the joint Storylets + Patter example, from `hamlet-v*`). Only those tag families render
// at all, which is what keeps any other release in the repo invisible here. Until a family
// has tagged, its row reads "coming soon".
//
// Used on the docs download page and on the landing page; the styles are global because the
// markup is injected with innerHTML, and they sit on Starlight's tokens, which
// storylets.css provides on both.
const { kind = "storyletter" } = Astro.props;
const repo = "storylet-studio/storylets";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"); // for the engine icons
---

{/* not-content: Starlight's escape hatch, exempting this subtree from its markdown flow
    styles (which otherwise stamp margin-top on every sibling and out-cascade our classes). */}
<div class="sy-dl not-content" data-sy-dl={kind} data-repo={repo} data-base={base}>
  <p class="sy-dl-status">Loading the latest release…</p>
</div>

<style is:global>
  /* Global (not scoped): the markup below is injected with innerHTML. */
  .sy-dl { margin: 1rem 0 1.5rem; }
  .sy-dl-status, .sy-dl-empty { color: var(--sl-color-gray-3); margin: 0; }
  .sy-dl-empty a { color: var(--sl-color-text-accent); }
  .sy-dl-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--sl-color-gray-5); }
  .sy-dl-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .sy-dl-row img { border-radius: 6px; flex: 0 0 auto; }
  .sy-dl-name { font-weight: 600; color: var(--sl-color-white); flex: 0 0 10rem; }
  .sy-dl-sub { flex: 1 1 12rem; color: var(--sl-color-gray-2); font-size: 0.88rem; margin: 0; }
  .sy-dl-soon { color: var(--sl-color-gray-3); font-size: 0.88rem; }
  /* A button has an edge at rest. Hover changes colour and nothing else. */
  .sy-dl-btn {
    display: inline-block; padding: 0.35rem 0.85rem; border-radius: 0.4rem;
    border: 1.5px solid var(--sl-color-text-accent); color: var(--sl-color-text-accent) !important;
    background: transparent; font-weight: 600; font-size: 0.88rem; text-decoration: none; white-space: nowrap;
    transition: background 0.15s ease;
  }
  .sy-dl-btn:hover { background: var(--sl-color-accent-low); }
  .sy-dl-meta { color: var(--sl-color-gray-3); font-size: 0.85rem; margin: 0.6rem 0 0; }
  .sy-dl-meta a { color: var(--sl-color-text-accent); }
  @media (max-width: 30rem) {
    .sy-dl-name { flex-basis: 100%; }
  }
</style>

<script>
  // One fetch shared across every section on the page (the script is hoisted and runs once).
  const mounts = Array.from(document.querySelectorAll<HTMLElement>("[data-sy-dl]"));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));

  type Release = { tag_name: string; html_url: string; published_at: string | null; draft: boolean; assets: { name: string; browser_download_url: string }[] };
  type Asset = { name: string; browser_download_url: string } | undefined;

  const row = (icon: string, name: string, sub: string, action: string): string =>
    `<li class="sy-dl-row">${icon}<span class="sy-dl-name">${esc(name)}</span><span class="sy-dl-sub">${sub}</span>${action}</li>`;
  const list = (rows: string[]): string => `<ul class="sy-dl-list">${rows.join("")}</ul>`;
  const button = (a: Asset, label: string): string =>
    a ? `<a class="sy-dl-btn" href="${esc(a.browser_download_url)}">${esc(label)}</a>` : `<span class="sy-dl-soon">coming soon</span>`;
  const link = (href: string, label: string): string => `<a class="sy-dl-btn" href="${esc(href)}">${esc(label)}</a>`;
  const meta = (r: Release, ver: string): string => {
    const date = r.published_at ? new Date(r.published_at).toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" }) : "";
    return `<p class="sy-dl-meta">Version ${esc(ver)}${date ? ", released " + esc(date) : ""}. <a href="${esc(r.html_url)}">Release notes</a>.</p>`;
  };

  function renderStoryletter(root: HTMLElement, releases: Release[]): void {
    const r = releases.find((x) => /^v\d/.test(x.tag_name)); // bare v* = Storyletter
    if (!r) return empty(root, "The Storyletter installers");
    const ver = r.tag_name.replace(/^v/, "");
    const find = (re: RegExp) => r.assets.find((a) => re.test(a.name));
    root.innerHTML = list([
      row("", "macOS", "Signed and notarised <code>.dmg</code>", button(find(/\.dmg$/i), "Download for macOS")),
      row("", "Windows", "One-click installer", button(find(/\.exe$/i), "Download for Windows")),
      row("", "Linux", "Self-contained AppImage", button(find(/\.AppImage$/i), "Download for Linux")),
    ]) + meta(r, ver);
  }

  function renderPlugins(root: HTMLElement, releases: Release[], base: string): void {
    const engines = [
      { key: "js", tag: /^play-js-v\d/, icon: "plugin-javascript.svg", name: "JavaScript", sub: "Web games and apps (TS/JS)" },
      { key: "unity", tag: /^play-unity-v\d/, icon: "plugin-unity.svg", name: "Unity", sub: "C# package, drop into <code>Packages/</code>" },
      { key: "unreal", tag: /^play-unreal-v\d/, icon: "plugin-unreal.svg", name: "Unreal", sub: "C++ plugin and demo project" },
      { key: "godot", tag: /^play-godot-v\d/, icon: "plugin-godot.svg", name: "Godot", sub: "GDScript addon for <code>addons/</code>" },
    ];
    const rows = engines.map((e) => {
      const r = releases.find((x) => e.tag.test(x.tag_name));
      const icon = `<img src="${base}${e.icon}" alt="" width="28" height="28" />`;
      if (!r) return row(icon, e.name, e.sub, `<span class="sy-dl-soon">coming soon</span>`);
      const ver = r.tag_name.replace(/^play-[a-z]+-v/, "");
      const zip = r.assets.find((a) => /\.zip$/i.test(a.name));
      return row(icon, `${e.name} ${ver}`, e.sub, button(zip, "Download zip"));
    });
    root.innerHTML = list(rows);
  }

  function renderCli(root: HTMLElement, releases: Release[]): void {
    const r = releases.find((x) => /^cli-v\d/.test(x.tag_name));
    if (!r) return empty(root, "The CLI binaries");
    const ver = r.tag_name.replace(/^cli-v/, "");
    const plats = [
      { re: /macos-arm64/i, label: "macOS (Apple silicon)" },
      { re: /macos-x64/i, label: "macOS (Intel)" },
      { re: /windows.*\.exe$/i, label: "Windows" },
      { re: /linux-x64/i, label: "Linux (x64)" },
      { re: /linux-arm64/i, label: "Linux (arm64)" },
    ];
    const rows = plats
      .map((p) => ({ p, a: r.assets.find((a) => p.re.test(a.name)) }))
      .filter((x) => x.a)
      .map((x) => row("", x.p.label, "One self-contained file", button(x.a, "Download")));
    root.innerHTML = list(rows) + meta(r, ver);
  }

  // The Village is the one section with somewhere to GO as well as something to
  // download, so it leads with the link: most people will play it rather than keep it.
  function renderVillage(root: HTMLElement, releases: Release[]): void {
    const play = row("", "In your browser", "Playable now, nothing to install", link("/village/", "Play the Village"));
    const r = releases.find((x) => /^village-v\d/.test(x.tag_name));
    if (!r) {
      root.innerHTML = list([play]) + `<p class="sy-dl-meta">The downloadable zip will appear here once the first release ships.</p>`;
      return;
    }
    const ver = r.tag_name.replace(/^village-v/, "");
    const zip = r.assets.find((a) => /\.zip$/i.test(a.name));
    root.innerHTML = list([play, row("", "The zip", "<code>dist/</code> to open offline, <code>src/</code> to read", button(zip, "Download zip"))]) + meta(r, ver);
  }

  // The Hamlet: playable in the browser like the Village, and ONE release carries
  // four zips (the JS client and the Godot, Unity and Unreal projects), so each
  // is offered by name rather than the first .zip found.
  function renderHamlet(root: HTMLElement, releases: Release[]): void {
    // Gated on the release existing: no play button and no zips until hamlet-v* ships,
    // because the site builds no /hamlet/ route until then (website/scripts/build-hamlet.mjs).
    const r = releases.find((x) => /^hamlet-v\d/.test(x.tag_name));
    if (!r) {
      root.innerHTML = `<p class="sy-dl-empty">Coming with its first release, once the words are written. The Village above is playable now.</p>`;
      return;
    }
    const ver = r.tag_name.replace(/^hamlet-v/, "");
    const find = (re: RegExp) => r.assets.find((a) => re.test(a.name));
    const zips = [
      { re: /^the-hamlet-\d[\w.-]*\.zip$/i, name: "JavaScript client", sub: "<code>src/</code> and <code>dist/</code>" },
      { re: /-godot-.*\.zip$/i, name: "Godot project", sub: "With Patter's plugin included" },
      { re: /-unity-.*\.zip$/i, name: "Unity project", sub: "With Patter's plugin included" },
      { re: /-unreal-.*\.zip$/i, name: "Unreal project", sub: "With Patter's plugin included" },
    ];
    const rows = [row("", "In your browser", "Playable now, nothing to install", link("/hamlet/", "Play the Hamlet"))].concat(
      zips.map((z) => ({ z, a: find(z.re) })).filter((x) => x.a).map((x) => row("", x.z.name, x.z.sub, button(x.a, "Download zip"))),
    );
    root.innerHTML = list(rows) + meta(r, ver);
  }

  function empty(root: HTMLElement, what: string): void {
    root.innerHTML = `<p class="sy-dl-empty">${what} will appear here once the first release ships. See <a href="https://github.com/storylet-studio/storylets/releases">GitHub Releases</a>.</p>`;
  }

  async function load(): Promise<void> {
    if (!mounts.length) return;
    const repo = mounts[0]!.dataset.repo!;
    const base = mounts[0]!.dataset.base ?? "/";
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/releases?per_page=50`, { headers: { Accept: "application/vnd.github+json" } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const releases: Release[] = (await res.json()).filter((r: Release) => !r.draft); // newest-first
      for (const m of mounts) {
        if (m.dataset.syDl === "storyletter") renderStoryletter(m, releases);
        else if (m.dataset.syDl === "plugins") renderPlugins(m, releases, base);
        else if (m.dataset.syDl === "cli") renderCli(m, releases);
        else if (m.dataset.syDl === "village") renderVillage(m, releases);
        else if (m.dataset.syDl === "hamlet") renderHamlet(m, releases);
      }
    } catch {
      for (const m of mounts) empty(m, "The downloads");
    }
  }

  load();
</script>
