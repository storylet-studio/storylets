.DS_Store
node_modules/
dist/
*.tsbuildinfo
dist-electron/

# Local Claude Code launch config (session-specific paths)
.claude/launch.json

# dotnet TestHost build output (ports)
ports/**/bin/
ports/**/obj/
ports/godot/.godot/

# Unity demo project: everything Unity regenerates on first open
ports/unity/**/[Ll]ibrary/
ports/unity/**/[Tt]emp/
ports/unity/**/[Oo]bj/
ports/unity/**/[Bb]uild/
ports/unity/**/[Ll]ogs/
ports/unity/**/UserSettings/
ports/unity/**/.vsconfig
ports/unity/StoryletEngineDemo/*.csproj
ports/unity/StoryletEngineDemo/*.sln
ports/unity/StoryletEngineDemo/*.slnx

# Local, uncommitted test assets for the labs (real floor plans, big images).
packages/studio/dev/local/

# Packaging output. The .icns set is genuinely rebuilt by the dist scripts: the
# mac icons are cut on the macOS runner, where sips exists. The .ico set is NOT,
# and must stay COMMITTED: its resize step is also sips, but it is consumed on a
# WINDOWS runner that has no sips to run it with. Ignoring them shipped a release
# job that failed with "cannot find specified resource doc-storyletproj.ico".
# Patter commits its .ico set for the same reason.
packages/studio/dist/
packages/studio/build/*.icns

# The Hamlet client's fetched copy of Patter's browser file (pinned release; see its build.mjs)
packages/hamlet-client/vendor/
