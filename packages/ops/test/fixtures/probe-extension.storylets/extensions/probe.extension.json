{
  "schema": "wildwinter/extension@0",
  "id": "probe",
  "name": "Probe",
  "version": "1.1.0",
  "docs": "https://storylets.dev",
  "settings": [
    { "name": "moodField", "label": "Mood field", "help": "The card field holding the card's mood.", "default": "mood" }
  ],
  "targets": {
    "storylets": {
      "card": {
        "fields": [
          { "name": "note", "type": "text", "label": "Note", "help": "A line for the crew." },
          { "name": "draft", "type": "multiline", "editorOnly": true, "help": "Working notes; never shipped." },
          { "name": "weight", "type": "number", "min": 0, "max": 10, "default": 1 },
          { "name": "loud", "type": "boolean" },
          { "name": "tone", "type": "enum", "values": ["calm", "tense"], "valueHelp": { "calm": "Unhurried.", "tense": "Clipped." } },
          { "name": "marks", "type": "flags", "values": ["night", "rain"] },
          { "name": "act", "type": "quality", "stages": ["setup", "turn", "close"], "renamedStages": { "opening": "setup" } },
          { "name": "next", "type": "reference", "to": "card" },
          { "name": "cue", "type": "record", "fields": [
            { "name": "sound", "type": "text", "required": true },
            { "name": "gain", "type": "number", "min": 0, "max": 1 }
          ] },
          { "name": "perf", "type": "map", "key": { "type": "reference", "to": "tag" }, "of": { "type": "enum", "values": ["smile", "frown"] } },
          { "name": "beats", "type": "list", "id": "id", "of": { "type": "record", "fields": [
            { "name": "id", "type": "text" }, { "name": "at", "type": "number" }
          ] } },
          { "name": "words", "type": "list", "of": { "type": "text" } }
        ],
        "claims": [
          { "setting": "moodField", "type": "enum", "values": ["calm", "tense"], "label": "Mood", "help": "The card's mood, as the probe reads it." }
        ]
      },
      "outcome": { "fields": [{ "name": "line", "type": "text" }] },
      "box": { "fields": [{ "name": "theme", "type": "text" }] },
      "deck": { "fields": [{ "name": "pile", "type": "number" }] },
      "tagGroup": { "fields": [{ "name": "shown", "type": "boolean" }] },
      "tag": { "fields": [{ "name": "colour", "type": "text", "default": "grey" }] },
      "handTemplate": { "fields": [{ "name": "size", "type": "number" }] },
      "hand": { "fields": [{ "name": "seat", "type": "enum", "values": ["north", "south"] }] },
      "project": { "fields": [{ "name": "studio", "type": "text" }] }
    }
  },
  "views": [
    { "id": "inspect", "name": "Probe view", "entry": "view/probe-view.js", "element": "probe-view", "hosts": ["storylets"] }
  ]
}
