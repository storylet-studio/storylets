{
  "name": "@storylet-studio/village-client",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The Village as a playable browser game: a worked example of using the Storylet Engine API.",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build:libs --prefix ../..",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs && node -e \"import('node:http').then(h=>import('node:fs').then(f=>h.createServer((q,s)=>{const p='dist'+(q.url==='/'?'/index.html':q.url.split('?')[0]);try{s.end(f.readFileSync(p))}catch{s.statusCode=404;s.end('no '+p)}}).listen(5180,()=>console.log('http://localhost:5180'))))\""
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
