{
  "name": "@storylet-studio/runtime",
  "version": "1.0.1",
  "description": "Storylet Engine JS reference runtime: the session (peek / deal / play / outcomes / board / save), held to the conformance corpus.",
  "homepage": "https://storylets.dev/play/javascript/",
  "keywords": [
    "storylets",
    "storylet-studio",
    "quality-based-narrative",
    "narrative",
    "interactive-fiction",
    "game-engine",
    "runtime"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/runtime"
  },
  "author": "Ian Thomas",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@storylet-studio/dialect": ">=0.1.0 <2.0.0",
    "@storylet-studio/model": ">=0.1.0 <2.0.0",
    "@wildwinter/expr": "^1.0.1",
    "@wildwinter/expr-specificity": "^1.0.0"
  },
  "peerDependencies": {
    "@wildwinter/scoperegistry": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@wildwinter/scoperegistry": ">=1.0.0 <2.0.0"
  }
}
