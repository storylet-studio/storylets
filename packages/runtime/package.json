{
  "name": "@storylet-studio/runtime",
  "version": "0.4.0",
  "description": "Storylet Engine JS reference runtime: the session (peek / deal / play / outcomes / board / save), held to the conformance corpus.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/runtime"
  },
  "author": "Ian Thomas",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@storylet-studio/dialect": "^0.1.0",
    "@storylet-studio/model": "^0.1.0",
    "@wildwinter/expr": "^0.5.0",
    "@wildwinter/expr-specificity": "^0.1.0",
    "@wildwinter/scoperegistry": "^0.5.0"
  }
}
