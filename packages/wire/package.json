{
  "name": "@storylet-studio/wire",
  "private": true,
  "version": "0.1.0",
  "description": "Storylet Server wire contract: types only, one definition of every request, response and SSE event that crosses the wire (storyletengine/wire@1).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/wire"
  },
  "author": "Ian Thomas",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@storylet-studio/model": ">=0.1.0 <1.0.0"
  }
}
