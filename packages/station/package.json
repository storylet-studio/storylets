{
  "name": "@storylet-studio/station",
  "private": true,
  "version": "0.1.0",
  "description": "Storylet Server reference stations: one plain web app per station kind (kiosk, crew, companion, sign-in, house), assembled from the station kit. Complete enough to run a venue, plain enough that nobody mistakes one for the venue's design.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/station"
  },
  "author": "Ian Thomas",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs && node -e \"import('node:http').then(h=>import('node:fs').then(f=>h.createServer((q,s)=>{const p='dist'+(q.url==='/'?'/kiosk/index.html':q.url.split('?')[0]);try{s.end(f.readFileSync(p))}catch{s.statusCode=404;s.end('no '+p)}}).listen(5181,()=>console.log('http://localhost:5181/kiosk/')))) \""
  },
  "dependencies": {
    "@storylet-studio/client": ">=0.1.0 <1.0.0",
    "@storylet-studio/station-kit": ">=0.1.0 <1.0.0",
    "@storylet-studio/wire": ">=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.7"
  }
}
