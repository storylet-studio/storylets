{
  "name": "@storylet-studio/station-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Storylet Server station UI parts: framework-neutral, in the family's tokens, each a function returning an element with update() and dispose(). The handshake, the hand, fields, zones, messages, the clock, the QR, the banner and the map.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/station-kit"
  },
  "author": "Ian Thomas",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@storylet-studio/client": ">=0.1.0 <1.0.0",
    "@storylet-studio/model": ">=0.3.0",
    "@storylet-studio/wire": ">=0.1.0 <1.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  }
}
