{
  "name": "@storylet-studio/play-helpers",
  "version": "1.0.0",
  "description": "Storylet Engine JS dev-experience layer: the state logger, save-file plumbing, and the in-page property examiner/editor. The runtime stays pure (no DOM, no I/O); everything that touches the host environment lives here.",
  "homepage": "https://storylets.dev/play/javascript/",
  "keywords": [
    "storylets",
    "storylet-studio",
    "quality-based-narrative",
    "narrative",
    "interactive-fiction",
    "live-link",
    "save-files"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/play-helpers"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "author": "Ian Thomas",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@storylet-studio/model": ">=0.1.0 <2.0.0",
    "@storylet-studio/runtime": "1.0.0",
    "@wildwinter/app-shell": ">=1.0.0 <2.0.0",
    "@wildwinter/expr": "^1.0.1"
  },
  "peerDependencies": {
    "@wildwinter/scoperegistry": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@wildwinter/scoperegistry": ">=1.0.0 <2.0.0"
  }
}
