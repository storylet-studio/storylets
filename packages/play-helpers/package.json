{
  "name": "@storylet-studio/play-helpers",
  "version": "0.4.1",
  "description": "Storylet Engine JS dev-experience layer: the state logger, save-file plumbing, and the in-page property examiner/editor. The runtime stays pure (no DOM, no I/O); everything that touches the host environment lives here.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/play-helpers"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "author": "Ian Thomas",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@storylet-studio/model": ">=0.1.0 <1.0.0",
    "@storylet-studio/runtime": "0.4.1",
    "@wildwinter/scoperegistry": "^0.5.0"
  }
}
