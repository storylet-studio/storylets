<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements. These three are the electron-builder defaults
     Electron needs to run at all under a hardened runtime. Patterpad carries a
     fourth, audio-input, for its scratch recording; this app records nothing, so
     it is deliberately absent - an entitlement you do not need is one more thing
     to justify at notarisation. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
