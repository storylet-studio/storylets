{
  "name": "@storylet-studio/compiler",
  "version": "1.0.1",
  "description": "Storylet Engine compiler: .storylets shards in, validated .storyletsc bundle out. Canonical serialisation, publish-gate validation, the hash32 staleness gate.",
  "type": "module",
  "license": "MIT",
  "author": "Ian Thomas",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://storylets.dev/",
  "keywords": [
    "storylets",
    "storylet-studio",
    "quality-based-narrative",
    "narrative",
    "interactive-fiction",
    "compiler"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@storylet-studio/dialect": "1.0.1",
    "@storylet-studio/model": "1.1.0",
    "@wildwinter/expr": "^1.0.1",
    "@wildwinter/toolkit": "^1.3.0",
    "json5": "^2.2.3"
  },
  "peerDependencies": {
    "@wildwinter/scoperegistry": ">=1.0.0 <2.0.0"
  }
}
