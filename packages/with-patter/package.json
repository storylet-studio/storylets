{
  "name": "@storylet-studio/with-patter",
  "version": "0.1.0",
  "description": "Storylets with Patter: perform a dealt card as the Patter scene named after it, take the outcome the scene reaches, and check the cards and scenes line up. DOM-free, for a game, the Board and the playable page alike.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storylet-studio/storylets.git",
    "directory": "packages/with-patter"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "author": "Ian Thomas",
  "keywords": [
    "storylets",
    "patter",
    "storylet-studio",
    "patterkit",
    "interactive-fiction",
    "dialogue"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./with-patter.min.js": "./dist/with-patter.min.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@storylet-studio/model": ">=0.1.0 <1.0.0"
  },
  "peerDependencies": {
    "@patterkit/runtime": ">=0.14.0 <1.0.0"
  }
}
